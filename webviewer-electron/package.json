{
  "name": "webviewer-electron",
  "version": "1.0.0",
  "description": "Sample to demonstrate integrating WebViewer into an Electron App",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "dev": "electron-forge start",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "release": "electron-forge release",
    "postinstall": "node scripts/copy-webviewer-files.cjs",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "typecheck": "tsc --noEmit",
    "test:unit": "jest",
    "test:e2e": "playwright test --config=__tests__/config/playwright.config.ts",
    "test:e2e:ui": "playwright test --ui --config=__tests__/config/playwright.config.ts"
  },
  "keywords": [],
  "author": "Apryse",
  "license": "ISC",
  "dependencies": {
    "@pdftron/webviewer": "^12.3.0",
    "electron-squirrel-startup": "^1.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-env": "^7.29.14",
    "@babel/preset-typescript": "^7.29.7",
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@happy-dom/jest-environment": "^21.0.4",
    "@jest/environment": "^30.5.2",
    "@jest/fake-timers": "^30.5.2",
    "@jest/types": "^30.5.1",
    "@playwright/test": "^1.65.1",
    "@types/jest": "^30.0.0",
    "babel-jest": "^30.5.2",
    "babel-plugin-transform-vite-meta-env": "^1.0.3",
    "electron": "45.3.4",
    "fs-extra": "^11.3.0",
    "jest": "^30.5.2",
    "jest-mock": "^30.5.2",
    "jest-util": "^30.5.1",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.94.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  }
}
