{
  "name": "webviewer-nextjs-sample",
  "license": "MIT",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/copy-webviewer-files.cjs",
    "dev": "npm run postinstall && next dev",
    "build": "npm run postinstall && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:e2e": "npx playwright install && npx playwright test --config=__tests__/config/playwright.config.ts",
    "test:e2e:ui": "npx playwright install && npx playwright test --ui --config=__tests__/config/playwright.config.ts"
  },
  "dependencies": {
    "@pdftron/webviewer": "^12.2.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@happy-dom/jest-environment": "^21.0.1",
    "@jest/environment": "^30.5.2",
    "@jest/fake-timers": "^30.5.2",
    "@jest/types": "^30.5.1",
    "@playwright/test": "^1.64.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "btoa": "^1.2.1",
    "eslint": "^10.12.0",
    "eslint-config-next": "^14.2.35",
    "fs-extra": "^11.4.1",
    "gh-pages": "^6.1.1",
    "jest": "^30.5.2",
    "jest-mock": "^30.5.2",
    "jest-util": "^30.5.1",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "argparse": "^3.0.2",
    "braces": "^3.0.3",
    "glob": "^13.0.6",
    "js-yaml": "^5.4.3",
    "sprintf-js": "^1.1.3"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "@parcel/watcher@2.6.0": true
  }
}
