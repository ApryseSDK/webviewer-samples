{
  "name": "webviewer-vue-sample",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-webviewer-files.cjs",
    "start": "concurrently \"npm run dev\" \"start http://localhost:5173\"",
    "dev": "npm run postinstall && vite",
    "build": "npm run postinstall && vite build",
    "type-check": "vue-tsc --noEmit",
    "serve": "vite preview",
    "lint": "eslint --fix .",
    "test:e2e": "npx playwright install && npx playwright test --config=__tests__/config/playwright.config.ts",
    "test:e2e:ui": "npx playwright install && npx playwright test --ui --config=__tests__/config/playwright.config.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@pdftron/webviewer": "^12.2.1",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@stylistic/eslint-plugin-js": "^4.4.1",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "fs-extra": "^11.4.1",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.13",
    "vue-eslint-parser": "^10.4.1"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
