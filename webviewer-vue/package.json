{
  "name": "webviewer-vue-sample",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "concurrently \"npm run dev\" \"start http://localhost:5173\"",
    "dev": "npm run copy-webviewer && vite",
    "build": "npm run copy-webviewer && vite build",
    "type-check": "vue-tsc --noEmit",
    "serve": "vite preview",
    "lint": "eslint --fix .",
    "copy-webviewer": "node scripts/copy-webviewer-files.cjs",
    "test:e2e": "npx playwright install && npx playwright test --config=__tests__/config/playwright.config.ts",
    "test:e2e:ui": "npx playwright install && npx playwright test --ui --config=__tests__/config/playwright.config.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@pdftron/webviewer": "^12.1.0",
    "vue": "^3.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.10.0",
    "@playwright/test": "^1.56.1",
    "@stylistic/eslint-plugin-js": "^2.13.0",
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.2",
    "eslint": "^9.19.0",
    "eslint-plugin-vue": "^9.32.0",
    "fs-extra": "^11.3.0",
    "globals": "^15.14.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.26.0",
    "vite": "^5.4.14",
    "vue-tsc": "^2.1.10"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}
